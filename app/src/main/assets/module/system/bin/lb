#!/system/bin/sh
[ "$(id -u)" = "0" ] || { echo "lb: 需要 root（su -c 'lb ...'）" >&2; exit 1; }
# 优先用已安装 APK，避免 /data/adb/lb/lb.apk 是旧副本导致命令缺失
APK=$(pm path com.lingyue.layerbridge 2>/dev/null | head -1 | cut -d: -f2)
[ -n "$APK" ] || APK=/data/adb/lb/lb.apk
[ -f "$APK" ] || { echo "lb: APK not found" >&2; exit 1; }
exec app_process -Djava.class.path="$APK" /system/bin com.lingyue.layerbridge.cli.LbMain "$@"
